# Copy to .env (gitignored) and fill in.

# Used by the bot: the parking poster's tap token and the discount code ID.
PARKING_TAP_TOKEN=
PARKING_DISCOUNT_CODE_ID=

# Laptop only: bin/dates and bin/plates then run on the server over SSH.
# Never set it on the server itself.
# PARKING_BOT_SSH=root@your-server
# PARKING_BOT_DIR=parking_bot            (the bot's folder, relative to the SSH user's home)
# PARKING_BOT_SSH_KEY=~/.ssh/id_ed25519  (only if your default key isn't the right one)
