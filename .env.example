# Copy to .env on your laptop so bin/dates and bin/plates run on the server.
# Leave .env out on the server itself.
PARKING_BOT_SSH=root@your-server
# Optional: the bot's folder on the server (relative to the SSH user's home) and an SSH key.
# PARKING_BOT_DIR=parking_bot
# PARKING_BOT_SSH_KEY=~/.ssh/id_ed25519
