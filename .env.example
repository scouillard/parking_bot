# Copy to .env (gitignored) and fill in.

# Used by the bot: the parking poster's tap token, and this season's discount
# code with its ID. Set the code with `bin/discount <code>`, which fills in the ID.
PARKING_TAP_TOKEN=
PARKING_DISCOUNT_CODE=
PARKING_DISCOUNT_CODE_ID=

# Used by `bin/dates sync`: the team's ID (team_id= in its schedule page URL)
# and the league site's ID (client_service_id, set in that site's page config).
SCHEDULE_TEAM_ID=
SCHEDULE_CLIENT_SERVICE_ID=
# PARKING_MINUTES_BEFORE=30   (how long before each game the parking starts)
